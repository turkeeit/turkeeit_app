    {
      "name": "verifySignature",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const secret = \"OqwDBXfVya9trAqDF3LBqZPt\";  // same as backend (for testing)\r",
              "\r",
              "// ✅ Read values from request body\r",
              "const body = JSON.parse(pm.request.body.raw);\r",
              "\r",
              "const order_id = body.razorpay_order_id;\r",
              "const payment_id = body.razorpay_payment_id;\r",
              "\r",
              "// create message\r",
              "const message = order_id + \"|\" + payment_id;\r",
              "\r",
              "// generate HMAC SHA256\r",
              "const hash = CryptoJS.HmacSHA256(message, secret);\r",
              "\r",
              "// convert to hex\r",
              "const signature = CryptoJS.enc.Hex.stringify(hash);\r",
              "\r",
              "// set variable\r",
              "pm.variables.set(\"signature\", signature);\r",
              "\r",
              "console.log(\"Generated Signature:\", signature);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
